# --- Server ---
PORT=3001
NODE_ENV=development
# Comma-separated origins allowed by CORS (the Next.js frontend).
FRONTEND_URL=http://localhost:3000
# Public URL of the storefront, used for Stripe success/cancel redirects.
STORE_URL=http://localhost:3000

# --- Database ---
# PostgreSQL connection string. Use a dedicated development database locally.
DATABASE_URL=postgresql://postgres:password@localhost:5432/upstate_equipment?schema=public

# --- Auth ---
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN_DAYS=7

# Admin account created/updated by `npm run db:seed`.
ADMIN_EMAIL=admin@upstateeq.com
ADMIN_PASSWORD=change-me-too

# --- Payments (optional) ---
# Leave empty to offer "Pay on invoice" only. With a key set, card checkout via
# Stripe Checkout is enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
